FROM node:20-alpine AS build
WORKDIR /workspace

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci
COPY frontend/ ./frontend/
RUN cd frontend && npm run build

COPY visual-ivr-app/package.json ./visual-ivr-app/
RUN cd visual-ivr-app && npm install
COPY visual-ivr-app/ ./visual-ivr-app/
RUN cd visual-ivr-app && npm run build

FROM nginx:1.27-alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/dist /usr/share/nginx/html
COPY --from=build /workspace/visual-ivr-app/dist /usr/share/nginx/html/v
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]