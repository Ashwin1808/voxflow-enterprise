# Generic multi-stage build for VoxFlow Spring Boot services.
# Build context must be the repository root:  docker build -f infra/Dockerfile.service --build-arg SERVICE=auth-service .
ARG SERVICE

FROM maven:3.9-eclipse-temurin-21 AS build
ARG SERVICE
WORKDIR /workspace
COPY pom.xml .
COPY workflow-engine ./workflow-engine
COPY services ./services
RUN mvn -q -pl services/${SERVICE} -am package -DskipTests

FROM eclipse-temurin:21-jre
ARG SERVICE
WORKDIR /app
COPY --from=build /workspace/services/${SERVICE}/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "app.jar"]